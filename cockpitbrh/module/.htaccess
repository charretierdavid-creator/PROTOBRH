# Module LM 2.0 — 15/11/2026 · protection du module lead management (Apache / LiteSpeed Hostinger) · historique : VERSIONS.md
Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
# fichiers jamais servis : configuration, bibliothèques PHP, documentation, sauvegardes (lm-base.php : module 1.x, s'il est resté sur le serveur)
<FilesMatch "^(config\.php|config\.example\.php|lm-base\.php|lm-db\.php|lm2-base\.php|lm2-referentiel\.php|VERSIONS\.md|LISEZMOI.*|.*\.(bak|sql|log|zip|sh|py|md|csv))$">
  Require all denied
</FilesMatch>
# connecteurs : seuls les scripts JS sont servis (lm-hub.js, lm-parcours.js) — lead.php est à copier sur les sites
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^connecteurs/(?!lm-hub\.js$|lm-parcours\.js$) - [F,L]
  RewriteRule ^(tests|sites|outils)/ - [F,L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(lm-hub|lm-parcours)\.js$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

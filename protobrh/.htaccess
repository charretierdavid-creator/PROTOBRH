# Porte d'accès (même modèle que Diagnostic Conseil BRH) : les pages et données ne sont servies
# qu'après identification. Les images, styles et scripts restent publics (aucune donnée).
# ============================================================================
# PAUSE-DPO: on
# Site suspendu à la demande du DPO (23/11/2026) : toutes les adresses, y compris les scripts PHP
# (demandes, avis, assistant, console), affichent pause.html ; aucune donnée n'est recueillie ni affichée.
# POUR ROUVRIR : supprimer ce bloc (de « PAUSE-DPO: on » à « FIN PAUSE-DPO ») puis mettre en ligne.
# ============================================================================
<IfModule mod_headers.c>
Header always set Cache-Control "no-store"
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^pause\.html$ - [L]
RewriteRule ^ pause.html [L]
</IfModule>
<IfModule !mod_rewrite.c>
Require all denied
</IfModule>
# FIN PAUSE-DPO
Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
<FilesMatch "^(config\.php|config\.example\.php|\.ftp-deploy-sync-state\.json)$">
Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^acces\.php$ - [L]
RewriteRule ^$ acces.php?f=index.html [L,QSA]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+\.(?:html?|json|txt|md|csv|sql|zip))$ acces.php?f=$1 [L,QSA]
</IfModule>

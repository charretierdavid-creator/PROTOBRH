# Porte d'accès (même modèle que Diagnostic Conseil BRH) : les pages et données ne sont servies
# qu'après identification. Les images, styles et scripts restent publics (aucune donnée).
Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
<FilesMatch "^(config\.php|config\.example\.php|\.ftp-deploy-sync-state\.json)$">
Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^acces\.php$ - [L]
RewriteRule ^$ acces.php?f=index.html [L,QSA]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+\.(?:html?|json|txt|md|csv|sql|zip))$ acces.php?f=$1 [L,QSA]
</IfModule>
